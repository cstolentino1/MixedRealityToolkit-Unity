      _value: 340
      _propertyDefinition:
        defaultValue: 340
        min: 0
        max: 360
        tooltip: 'Outer cone angle. Range: 0 to 360.'
        label: 
    outerGain:
      main:
        _propertyName: main
        _value: 1
        _propertyDefinition:
          defaultValue: 1
          min: 0
          max: 1
          tooltip: 'Gain in dB outside the outer cone. Range: -96 to 0.'
          label: Main
      lf:
        _propertyName: lf
        _value: 0.65
        _propertyDefinition:
          defaultValue: 0.65
          min: 0
          max: 1
          tooltip: Low Frequency gain offset outside the outer cone.
          label: LF
      mf:
        _propertyName: mf
        _value: 0.4
        _propertyDefinition:
          defaultValue: 0.4
          min: 0
          max: 1
          tooltip: Mid Frequency gain offset outside the outer cone.
          label: MF
      hf:
        _propertyName: hf
        _value: 0.080000006
        _propertyDefinition:
          defaultValue: 0.08
          min: 0
          max: 1
          tooltip: High Frequency gain offset outside the outer cone.
          label: HF
  gain:
    _propertyName: gain
    _value: 1
    _propertyDefinition:
      defaultValue: 1
      min: 0
      max: 8
      tooltip: 'Set the overall gain for a source. This gain affects all paths: Direct,
        Reflections, and Reverb.'
      label: 
  obstructionOverride:
    main:
      _propertyName: main
      _value: 0
      _propertyDefinition:
        defaultValue: 0
        min: 0
        max: 1
