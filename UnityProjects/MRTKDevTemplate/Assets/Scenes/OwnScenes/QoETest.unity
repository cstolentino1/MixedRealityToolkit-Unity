    lf:
      _propertyName: lf
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
        tooltip: Indirect-path relative gain offset for low frequencies.
        label: LF
    mf:
      _propertyName: mf
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
        tooltip: Indirect-path relative gain offset for mid frequencies.
        label: MF
    hf:
      _propertyName: hf
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
        tooltip: Indirect-path relative gain offset for high frequencies.
        label: HF
  dispersionSendLevel:
    main:
      _propertyName: main
      _value: 1
      _propertyDefinition:
        defaultValue: 1
