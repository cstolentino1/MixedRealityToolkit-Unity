    mf:
      _propertyName: mf
      _value: 0
      _propertyDefinition:
        defaultValue: 0
        min: 0
        max: 1
        tooltip: Overrides obstruction for mid frequencies
        label: MF
    hf:
      _propertyName: hf
      _value: 0
      _propertyDefinition:
        defaultValue: 0
        min: 0
        max: 1
        tooltip: Overrides obstruction for high frequencies
        label: HF
  directLevel:
    main:
      _propertyName: main
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
        tooltip: Direct-path gain offset.
        label: Main
    lf:
      _propertyName: lf
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
        tooltip: Direct-path relative gain offset for low frequencies.
        label: LF
    mf:
      _propertyName: mf
      _value: 1
      _propertyDefinition:
        defaultValue: 1
        min: 0
        max: 1
